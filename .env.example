DATABASE_URL=postgres://careerbridge:careerbridge@localhost:5432/careerbridge
# Host port docker-compose binds Postgres to (127.0.0.1 only); change if 5432 is already taken locally.
POSTGRES_HOST_PORT=5432
SESSION_SECRET=dev-only-change-me
SESSION_IDLE_HOURS=8
ADMIN_EMAIL=admin@careerbridge.local
ADMIN_PASSWORD=change-me
RESUME_MAX_BYTES=2097152
TZ=America/Chicago
SEED_DEMO=true
PORT=3000
NODE_ENV=development
